# APP_URL: The public URL of the deployed application (e.g., https://catafy.vercel.app)
APP_URL="https://catafy.vercel.app"

# JWT_SECRET: Secret key for signing and validating session tokens.
# Set a strong random secret in Vercel Environment Variables (e.g. openssl rand -hex 32)
JWT_SECRET="generate_a_secure_jwt_secret_for_production"

# GEMINI_API_KEY: Optional - Required only if AI features are enabled.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

